# CLI-Agent Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# LLM API Keys (at least one is required)
# =============================================================================

# OpenAI API (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for Claude models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (for Gemini models)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq API (for fast inference)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA API (for NVIDIA models)
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# =============================================================================
# Search API Keys
# =============================================================================

# Brave Search API (for web searches)
# Get from: https://api.search.brave.com/
BRAVE_API_KEY=your_brave_search_api_key_here

# =============================================================================
# CLI-Agent Docker Configuration
# =============================================================================

# Enable GUI mode (visual response interface) - Required for Docker
CLI_AGENT_GUI_MODE=true

# Host to bind the visual server to
# Use 0.0.0.0 for external access, 127.0.0.1 for localhost only
CLI_AGENT_HOST=0.0.0.0

# Data directories (will be created automatically in container)
CLI_AGENT_DATA_DIR=/cli-agent/data
CLI_AGENT_LOG_DIR=/cli-agent/logs
CLI_AGENT_TEMP_DIR=/cli-agent/temp

# =============================================================================
# Docker Resource Limits
# =============================================================================

# Memory limit for the container (adjust based on your system)
MEMORY_LIMIT=2G

# CPU limit for the container
CPU_LIMIT=1.0

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================

# Ollama hosts (comma-separated, for local models)
OLLAMA_HOSTS=localhost:11434

# Force local mode (set to 'true' to use only local models)
FORCE_LOCAL=false

# Debug mode (set to 'true' for verbose logging)
DEBUG=false

# Python configuration (for container)
PYTHONPATH=/cli-agent
PYTHONUNBUFFERED=1
DEBIAN_FRONTEND=noninteractive

# =============================================================================
# Local Development Overrides
# =============================================================================

# Uncomment these for local development with volume mounts
# CLI_AGENT_DATA_DIR=./local-data
# CLI_AGENT_LOG_DIR=./local-logs
# CLI_AGENT_TEMP_DIR=./local-temp

# =============================================================================
# Security Notes
# =============================================================================

# IMPORTANT: Never commit this file with real API keys to version control!
#
# For production deployment:
# 1. Use environment variable injection from your deployment platform
# 2. Consider using secrets management (AWS Secrets Manager, etc.)
# 3. Rotate API keys regularly
# 4. Monitor API usage and costs
#
# Usage:
# docker-compose -f docker-compose.prod.yml up -d