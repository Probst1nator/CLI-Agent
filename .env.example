# CLI-Agent Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# LLM API Keys (at least one is required)
# =============================================================================

# OpenAI API (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for Claude models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (for Gemini models)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq API (for fast inference)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA API (for NVIDIA models)
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# =============================================================================
# Search API Keys
# =============================================================================

# Brave Search API (for web searches)
# Get from: https://api.search.brave.com/
BRAVE_API_KEY=your_brave_search_api_key_here

# =============================================================================
# CLI-Agent Configuration
# =============================================================================

# Enable GUI mode (visual response interface)
CLI_AGENT_GUI_MODE=true

# Host to bind the visual server to
# Use 0.0.0.0 for external access, 127.0.0.1 for localhost only
CLI_AGENT_HOST=127.0.0.1

# =============================================================================
# Advanced Configuration (Optional)
# =============================================================================

# Ollama hosts (comma-separated, for local models)
OLLAMA_HOSTS=localhost:11434

# HuggingFace Local Models Configuration
# Directory for storing downloaded models (default: ~/.cli-agent/models/)
HF_LOCAL_MODELS_DIR=~/.cli-agent/models/

# HuggingFace token (required for gated models like Llama)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Device for local inference (auto, cuda, cpu, mps)
# auto = automatically detect GPU, fallback to CPU
HF_LOCAL_DEVICE=auto

# Maximum VRAM to use for models (in GB)
# Helps prevent OOM errors on GPU
HF_LOCAL_MAX_MEMORY_GB=16

# Force local mode (set to 'true' to use only local models)
FORCE_LOCAL=false

# Debug mode (set to 'true' for verbose logging)
DEBUG=false

# =============================================================================
# Docker Isolated Mode Configuration (--isolated flag)
# =============================================================================

# Memory limit for isolated container
MEMORY_LIMIT=2G

# CPU limit for isolated container
CPU_LIMIT=1.0

# =============================================================================
# Security Notes
# =============================================================================

# IMPORTANT: Never commit this file with real API keys to version control!
# 1. Rotate API keys regularly
# 2. Monitor API usage and costs
