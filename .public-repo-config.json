{
  "repository": {
    "name": "CLI-Agent",
    "description": "Research project for autonomous AI agent systems with LLM integration",
    "purpose": "research",
    "visibility": "public"
  },

  "tools": {
    "privileged": {
      "tools": [
        "bash.py",
        "writefile.py",
        "editfile.py",
        "insertline.py",
        "deletelines.py",
        "computercontrol.py"
      ],
      "marker": "PRIVILEGED",
      "warning": "⚠️ PRIVILEGED TOOL: This tool performs system-level operations that modify state. Use with appropriate sandboxing. Recommended: --isolated mode.",
      "action": "mark_and_move"
    },

    "excluded": {
      "directories": [
        "tools/disabled/",
        "saas_scripts/",
        "docker_files/traefik/"
      ],
      "files": [
        ".env",
        "*.log",
        "**/deployment_logs/**"
      ]
    }
  },

  "sync": {
    "auto_sync": false,
    "require_manual_review": true,
    "run_tests_before_push": false
  }
}
