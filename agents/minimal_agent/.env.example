# Minimal Agent Configuration

# API Keys (at least one required)
# For Google (Gemini) models - recommended
GOOGLE_API_KEY=your-google-api-key-here

# For Ollama (Local models) - no API key needed, just install Ollama
# Download from: https://ollama.ai/

# For Anthropic (Claude) models
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default model to use (optional)
# Options (in order of preference):
#   - gemini-flash-latest (Google - fast and recommended)
#   - gemini-flash-lite-latest (Google - lighter, even faster)
#   - llama3.2 (Ollama - local, free)
#   - mistral (Ollama - local, free)
#   - claude-haiku-4-5 (Anthropic - fast and efficient)
DEFAULT_MODEL=gemini-flash-latest
