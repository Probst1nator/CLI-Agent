# API Keys (configure at least one)
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default model (optional - uses fallback chain if not specified)
# Options: gemini-flash-lite-latest, gemini-flash-latest, qwen3:1.7b, claude-4-5-haiku
DEFAULT_MODEL=gemini-flash-latest

# GitHub CLI (gh) should be installed and authenticated separately
# Install: https://cli.github.com/
# Auth: gh auth login
