name: Deploy to Staging

on:
  push:
    branches:
      - main
      - develop
  pull_request:
    branches:
      - release
  workflow_dispatch:

env:
  REGISTRY: ghcr.io
  REPOSITORY_LOWERCASE: ${{ github.repository }}
  IMAGE_NAME: ${{ github.repository }}/cli-agent-backend

jobs:
  test:
    name: Run Tests
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'
          cache: 'pip'
      
      - name: Install dependencies
        run: |
          pip install -r requirements.txt
      
      - name: Run quick tests
        run: |
          python run_tests.py --quick
      
      - name: Run linting
        run: |
          ruff check . || true
          black --check . || true

  build-staging:
    name: Build Staging Images
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      repository_lowercase: ${{ steps.repo-name.outputs.repository_lowercase }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set lowercase repository name
        id: repo-name
        run: echo "repository_lowercase=$(echo '${{ github.repository }}' | tr '[:upper:]' '[:lower:]')" >> $GITHUB_OUTPUT

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Build backend image (staging)
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./docker_files/Dockerfile.backend
          push: true
          tags: ${{ env.REGISTRY }}/${{ steps.repo-name.outputs.repository_lowercase }}/cli-agent-backend:staging-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
      
      - name: Build frontend image (staging)
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./docker_files/Dockerfile.frontend
          push: true
          tags: ${{ env.REGISTRY }}/${{ steps.repo-name.outputs.repository_lowercase }}/cli-agent-frontend:staging-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  deploy-staging:
    name: Deploy to Production (from Staging)
    needs: build-staging
    runs-on: ubuntu-latest
    if: github.event_name == 'push'
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Deploy to production server
        uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          port: ${{ secrets.DEPLOY_PORT || 22 }}
          script: |
            set -e
            
            # Navigate to deployment directory
            cd ${{ secrets.DEPLOY_PATH || '/opt/cli-agent' }}
            
            # Pull latest code from main/develop branch
            git fetch origin
            git checkout ${{ github.ref_name }}
            git pull origin ${{ github.ref_name }}
            
            # Pull staging images from GitHub Container Registry
            echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin

            docker pull ${{ env.REGISTRY }}/${{ needs.build-staging.outputs.repository_lowercase }}/cli-agent-backend:staging-${{ github.sha }}
            docker pull ${{ env.REGISTRY }}/${{ needs.build-staging.outputs.repository_lowercase }}/cli-agent-frontend:staging-${{ github.sha }}

            # Tag staging images for production use
            docker tag ${{ env.REGISTRY }}/${{ needs.build-staging.outputs.repository_lowercase }}/cli-agent-backend:staging-${{ github.sha }} cli-agent-backend:latest
            docker tag ${{ env.REGISTRY }}/${{ needs.build-staging.outputs.repository_lowercase }}/cli-agent-frontend:staging-${{ github.sha }} cli-agent-frontend:latest
            
            # Restart infrastructure services
            cd docker_files
            docker compose -f docker-compose.infrastructure.yml up -d --force-recreate
            
            # Rolling update of backend containers
            echo "Starting rolling update of backend containers..."
            CONTAINERS=$(docker ps --filter "name=cli-agent-" --format "{{.Names}}" | grep -v "cli-agent-container-manager\|cli-agent-frontend\|cli-agent-traefik\|cli-agent-isolated")
            
            for container in $CONTAINERS; do
              echo "Restarting $container..."
              docker restart $container
              sleep 2
            done
            
            # Clean up old images
            docker image prune -f
            
            echo "✅ Production deployment complete!"
      
      - name: Verify deployment
        uses: appleboy/ssh-action@v1.0.0
        with:
          host: ${{ secrets.DEPLOY_HOST }}
          username: ${{ secrets.DEPLOY_USER }}
          key: ${{ secrets.DEPLOY_SSH_KEY }}
          port: ${{ secrets.DEPLOY_PORT || 22 }}
          script: |
            # Check container health
            echo "=== Container Status ==="
            docker ps --filter "name=cli-agent-" --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"
            
            # Check Container Manager health
            echo ""
            echo "=== Container Manager Health ==="
            curl -f http://localhost:8080/health || echo "❌ Container Manager unhealthy"
            
            # Check frontend health
            echo ""
            echo "=== Frontend Health ==="
            curl -f http://localhost/ -I || echo "❌ Frontend unhealthy"
