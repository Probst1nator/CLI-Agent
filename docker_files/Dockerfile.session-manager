# Session Manager for CLI-Agent Multi-Instance Setup
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    docker \
    redis \
    requests

# Copy session manager code
COPY scripts/session_manager.py .

EXPOSE 8000

CMD ["uvicorn", "session_manager:app", "--host", "0.0.0.0", "--port", "8000"]