FROM python:3.11-slim

LABEL maintainer="CLI-Agent Team"
LABEL description="Container Manager for CLI-Agent Multi-User Architecture"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    gunicorn==21.2.0 \
    docker==7.1.0 \
    httpx==0.25.1 \
    websockets==12.0 \
    psutil==5.9.6

# Copy container manager code
COPY api/container_manager.py /app/container_manager.py

# Create data directory
RUN mkdir -p /data

# Create non-root user with docker group access
# GID 999 is commonly used for docker group, but may need adjustment based on host
# The host's docker group GID should match this for socket access
RUN groupadd -g 999 docker || true && \
    useradd -m -u 1000 -g 999 -s /bin/bash containermgr && \
    chown -R containermgr:docker /app /data

# Switch to non-root user
USER containermgr

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Use gunicorn with uvicorn workers for production-grade concurrency
# 4 workers provides good balance between concurrency and resource usage
CMD ["gunicorn", "-k", "uvicorn.workers.UvicornWorker", "-w", "4", "-b", "0.0.0.0:8080", "--access-logfile", "-", "--error-logfile", "-", "--log-level", "info", "container_manager:app"]
