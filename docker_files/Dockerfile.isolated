FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /workspace

# Install system dependencies for isolated production environment
RUN apt-get update && apt-get install -y \
    # Essential tools
    git \
    curl \
    wget \
    unzip \
    rsync \
    netcat \
    # Build essentials for Python packages
    build-essential \
    # Python 3.10+ for CLI-Agent
    python3 \
    python3-pip \
    python3-venv \
    python3-tk \
    # Additional production dependencies
    ca-certificates \
    gnupg \
    lsb-release \
    # Audio dependencies for TTS functionality
    espeak \
    espeak-data \
    # File management tools
    tree \
    htop \
    # Network tools for health checks
    iputils-ping \
    dnsutils \
    # Clean up to reduce image size
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip to latest version
RUN pip3 install --no-cache-dir --upgrade pip

# Copy CLI-Agent source code
COPY . /cli-agent/
WORKDIR /cli-agent

# Verify core files exist and install dependencies
RUN ls -la /cli-agent/ && \
    test -f main.py && \
    test -f requirements.txt && \
    pip3 install --no-cache-dir -r requirements.txt

# Create a non-root user for security
RUN useradd -m -u 1000 -s /bin/bash cliagent && \
    usermod -aG sudo cliagent && \
    echo 'cliagent ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Create directories for data persistence
RUN mkdir -p /workspace/data /workspace/logs /workspace/temp /workspace/.cli-agent && \
    chown -R cliagent:cliagent /workspace /cli-agent

# Set environment variables for isolated production
ENV PYTHONPATH=/cli-agent
ENV PYTHONUNBUFFERED=1
ENV CLI_AGENT_GUI_MODE=true
ENV CLI_AGENT_HOST=0.0.0.0
ENV CLI_AGENT_DATA_DIR=/workspace/data
ENV CLI_AGENT_LOG_DIR=/workspace/logs
ENV CLI_AGENT_TEMP_DIR=/workspace/temp

# Switch to non-root user
USER cliagent

# Expose the visual response server port
EXPOSE 7861

# Set the default command to run CLI-Agent in GUI mode
CMD ["python3", "main.py", "--gui"]