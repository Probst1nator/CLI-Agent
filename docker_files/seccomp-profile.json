  "comment": "CLI-Agent seccomp profile - Blocks dangerous syscalls while allowing normal container operations",
  "blockedSyscalls": {
    "comment": "The following dangerous syscalls are explicitly BLOCKED by this profile:",
    "list": [
      "acct - Process accounting",
      "add_key - Add a key to the kernel keyring",
      "bpf - BPF system call",
      "clock_adjtime - Adjust system clock",
      "clock_settime - Set system clock",
      "create_module - Create loadable kernel module",
      "delete_module - Delete loadable kernel module",
      "finit_module - Load kernel module",
      "get_kernel_syms - Get kernel symbols",
      "get_mempolicy - Get NUMA memory policy",
      "init_module - Load kernel module",
      "ioperm - Set port I/O permissions",
      "iopl - Change I/O privilege level",
      "kcmp - Compare two processes",
      "kexec_file_load - Load new kernel for later execution",
      "kexec_load - Load new kernel for later execution",
      "keyctl - Manipulate kernel key management",
      "lookup_dcookie - Return directory entry's path",
      "mbind - Set memory policy for memory range",
      "mount - Mount filesystem",
      "move_pages - Move process pages",
      "name_to_handle_at - Get handle for pathname",
      "open_by_handle_at - Open file via handle",
      "perf_event_open - Performance monitoring",
      "personality - Set process execution domain",
      "pivot_root - Change root filesystem",
      "process_vm_readv - Read from another process",
      "process_vm_writev - Write to another process",
      "ptrace - Process trace/debug",
      "query_module - Query loadable kernel module",
      "quotactl - Quota control",
      "reboot - Reboot system",
      "request_key - Request a key from kernel",
      "set_mempolicy - Set NUMA memory policy",
      "setdomainname - Set domain name",
      "sethostname - Set hostname",
      "setns - Set namespace",
      "settimeofday - Set system time",
      "swapon - Start swapping to file/device",
      "swapoff - Stop swapping to file/device",
      "sysfs - Get filesystem type information",
      "_sysctl - Read/write system parameters",
      "syslog - Read/clear kernel message ring buffer",
      "umount - Unmount filesystem",
      "umount2 - Unmount filesystem",
      "unshare - Disassociate parts of process execution context",
      "uselib - Load shared library",
      "userfaultfd - Create userfaultfd object",
      "ustat - Get filesystem statistics",
      "vm86 - Enter virtual 8086 mode",
      "vm86old - Enter virtual 8086 mode"
    ]
  }
