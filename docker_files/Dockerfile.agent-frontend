FROM nginx:alpine

LABEL maintainer="CLI-Agent Team"
LABEL description="Agent Management SaaS Frontend"

# Copy NEW agent-saas frontend files
COPY agent-saas/frontend/ /usr/share/nginx/html/

# Copy nginx configuration
COPY docker_files/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
