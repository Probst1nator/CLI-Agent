# Base image for all CLI-Agent SaaS agents
# Provides shared Python environment and common dependencies

FROM python:3.11-slim

# Set working directory
WORKDIR /agent

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install common Python dependencies (all agents need these)
RUN pip install --no-cache-dir \
    # LLM providers
    anthropic>=0.39.0 \
    google-generativeai>=0.3.0 \
    ollama>=0.1.0 \
    # Web server for agent communication
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    websockets==12.0 \
    # Utilities
    chardet>=5.0.0 \
    aiofiles==23.2.1 \
    python-multipart==0.0.6

# Create directories for data/logs/config
RUN mkdir -p /workspace/data /workspace/logs /workspace/config

# Health check (will be overridden by specific agents)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command (will be overridden by specific agents)
CMD ["python", "-m", "uvicorn", "agent_server:app", "--host", "0.0.0.0", "--port", "8000"]
