# Minimal Agent Docker Image
# Lightweight read-only agent with 4 tools: think, todos, readfile, grepsearch

FROM cli-agent-base:latest

# Set agent-specific environment variables
ENV AGENT_CLASS_NAME="MinimalAgent" \
    AGENT_MODULE_NAME="main" \
    AGENT_TYPE="minimal_agent" \
    PYTHONUNBUFFERED=1

# Copy agent code
COPY agents/minimal_agent/ /agent/

# Copy agent server wrapper
COPY agent-saas/docker/agent_server.py /agent/agent_server.py

# Ensure tools directory exists
RUN test -d /agent/tools || (echo "ERROR: tools directory not found" && exit 1)

# Verify agent structure
RUN python -c "from main import MinimalAgent; agent = MinimalAgent(); print(f'Loaded {len(agent.tools)} tools')"

# Expose port for agent communication
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run agent server
CMD ["python", "-m", "uvicorn", "agent_server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
