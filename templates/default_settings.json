{
  "_comment": "Default permission settings for CLI-Agent. Copy to ~/.cli-agent/settings.json and customize.",
  "permissions": {
    "allow": [
      "bash(ls:*)",
      "bash(pwd:*)",
      "bash(cat:*)",
      "bash(grep:*)",
      "bash(find:*)",
      "bash(rg:*)",
      "bash(npm run:*)",
      "bash(npm test:*)",
      "bash(pip list:*)",
      "bash(pytest:*)",
      "bash(python:*)",
      "bash(ruff:*)",
      "bash(black:*)",
      "bash(flake8:*)",
      "bash(mypy:*)",
      "readfile(./src/**)",
      "readfile(./tests/**)",
      "readfile(./docs/**)",
      "readfile(./**/*.py)",
      "readfile(./**/*.js)",
      "readfile(./**/*.ts)",
      "readfile(./**/*.json)",
      "readfile(./**/*.md)",
      "editfile(./src/**)",
      "editfile(./tests/**)",
      "writefile(./src/**)",
      "writefile(./tests/**)",
      "grepsearch(**)"
    ],
    "deny": [
      "readfile(.env)",
      "readfile(.env.*)",
      "readfile(./secrets/**)",
      "readfile(./credentials/**)",
      "readfile(./**/.env)",
      "readfile(./**/.env.*)",
      "bash(sudo:*)",
      "bash(rm -rf:*)",
      "bash(dd:*)",
      "bash(mkfs:*)",
      "bash(chmod 777:*)",
      "bash(curl * | bash:*)",
      "bash(wget * | bash:*)",
      "writefile(.env)",
      "writefile(.env.*)",
      "editfile(.env)",
      "editfile(.env.*)"
    ],
    "ask": [
      "bash(git push:*)",
      "bash(git force-push:*)",
      "bash(git push --force:*)",
      "bash(docker:*)",
      "bash(npm install:*)",
      "bash(npm uninstall:*)",
      "bash(pip install:*)",
      "bash(pip uninstall:*)",
      "writefile(./package.json)",
      "writefile(./requirements.txt)",
      "writefile(./pyproject.toml)",
      "editfile(./package.json)",
      "editfile(./requirements.txt)",
      "editfile(./pyproject.toml)"
    ]
  }
}
