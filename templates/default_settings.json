{
  "_comment": "Default permission settings for CLI-Agent. Copy to ~/.cli-agent/settings.json and customize.",
  "permissions": {
    "allow": [
      "searchconversations",
      "paralleltools",
      "grepsearch",
      "searchresource",
      "searchweb",
      "viewpermissions"
    ],
    "deny": [
      "bash(sudo:*)",
      "bash(rm -rf:*)",
      "bash(dd:*)",
      "bash(mkfs:*)"
    ],
    "ask": [
      "bash(git push:*)",
      "bash(docker:*)",
      "writefile",
      "editfile"
    ]
  }
}
